# Tailscale API Key (tskey-api-...)
# Required if querying devices/ACLs via the REST API or when local CLI is unavailable.
TAILSCALE_API_KEY=

# Tailscale Tailnet identifier (e.g., example.com, user@gmail.com, or "-" for default tailnet of API key)
TAILSCALE_TAILNET=-

# Custom path to local tailscale binary (optional; auto-detected if omitted)
# e.g., /Applications/Tailscale.app/Contents/MacOS/Tailscale or /usr/local/bin/tailscale
TAILSCALE_CLI_PATH=

# Tailscale REST API base URL (defaults to https://api.tailscale.com/api/v2)
TAILSCALE_API_BASE_URL=https://api.tailscale.com/api/v2

# Log level: debug | info | warn | error
LOG_LEVEL=info
