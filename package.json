{
  "name": "tailscale-mesh-mcp",
  "version": "0.2.0",
  "description": "Production-grade Model Context Protocol (MCP) server for Tailscale and mesh zero-trust network management",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "tailscale-mesh-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tailscale",
    "vpn",
    "mesh-network",
    "zero-trust",
    "devops"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
